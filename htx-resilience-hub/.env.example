# Copy to .env at the monorepo root. These are local-only development values.
DATABASE_URL=postgresql://htx:local_dev_only@localhost:5432/htx
POSTGRES_USER=htx
POSTGRES_PASSWORD=local_dev_only
POSTGRES_DB=htx
# Required only when the corresponding integration is invoked.
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
BACKBOARD_API_KEY=
AIRNOW_API_KEY=
# Next.js server-side proxy; never exposed as NEXT_PUBLIC_*.
API_BASE_URL=http://127.0.0.1:8000
GEMINI_MODEL=gemini-3.1-flash-lite
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Use one stable random token for the API and web proxy, including local development.
INTERNAL_API_TOKEN=
# Optional: use 3001 if 3000 is occupied.
# HTX_WEB_PORT=3001
# Explicit fallback mode: profiles are temporary if the database is unavailable.
NOACH_DEMO_MODE=true
# Optional database-free local rehearsal. Preferences, simulated anomalies and alerts stay in API process memory.
# NOACH_DEMO_STORAGE=memory
# Set explicitly only for a rehearsed public demo; disabled by default in production.
NOACH_ALLOW_SIMULATION=false
NOACH_ENV=development
HOSTING_PROVIDER=local development
