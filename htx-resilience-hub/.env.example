# Copy to .env at the monorepo root. These are local-only development values.
DATABASE_URL=postgresql://htx:local_dev_only@localhost:5432/htx
POSTGRES_USER=htx
POSTGRES_PASSWORD=local_dev_only
POSTGRES_DB=htx
# Required only when the corresponding integration is invoked.
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
BACKBOARD_API_KEY=
# Next.js server-side proxy; never exposed as NEXT_PUBLIC_*.
API_BASE_URL=http://127.0.0.1:8000
GEMINI_MODEL=gemini-flash-latest
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
INTERNAL_API_TOKEN=
# Explicit fallback mode: profiles are temporary if the database is unavailable.
NOACH_DEMO_MODE=true
NOACH_ENV=development
HOSTING_PROVIDER=local development
